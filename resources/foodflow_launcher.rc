#define IDI_FOODFLOW 101

IDI_FOODFLOW ICON "foodflow.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FoodFlow"
            VALUE "FileDescription", "FoodFlow - Gestion y trazabilidad de pedidos"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "FoodFlow"
            VALUE "OriginalFilename", "FoodFlow.exe"
            VALUE "ProductName", "FoodFlow"
            VALUE "ProductVersion", "1.0.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END